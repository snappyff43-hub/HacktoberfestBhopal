# Environment configuration for CreatorFlow AI Backend

# HeyGen V3 Official API
# Generate key at: https://platform.heygen.com/api-keys
HEYGEN_API_KEY=
HEYGEN_BASE_URL=https://api.heygen.com

# Local Ollama & Gemma 4
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b-it-qat

# Database URL (SQLite fallback default, or PostgreSQL / Supabase)
# SQLite default: sqlite:///./creatorflow.db
# PostgreSQL: postgresql://user:password@localhost:5432/creatorflow
DATABASE_URL=sqlite:///./creatorflow.db

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
