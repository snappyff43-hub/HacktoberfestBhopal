# Environment configuration for CreatorFlow AI Backend (Template)
# Copy this file to .env and insert your authorized credentials.

# 1. HeyGen V3 Official API
# Generate key at: https://platform.heygen.com/api-keys
HEYGEN_API_KEY=your_heygen_v3_api_key_here
HEYGEN_BASE_URL=https://api.heygen.com

# 2. Local Ollama & Gemma 4 (Local Development Runtime)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b-it-qat

# 3. Google Gemini Flash API (Cloud Polish & Multi-Platform Adaptation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 4. NVIDIA NIM Cloud LLM (Optional Cloud Provider)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# 5. Sentry Error Tracking & Performance Monitoring (Optional)
SENTRY_DSN=

# 6. Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./creatorflow.db
# Cloud PostgreSQL / Supabase example:
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# 7. Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
